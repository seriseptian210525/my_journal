# ========================================
# my_journal - Environment Configuration Template
# ========================================
# Copy this file to `.env` and fill in your actual values
# NEVER commit the `.env` file to version control!

# ========================================
# Google Sheets Configuration
# ========================================
# Each Google Sheets file has its own unique Spreadsheet ID
# Format: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit

# --- S1-S5: Form-based Sources ---
# Form Service 2024-25
SHEET_ID_FORM_SERVICE=your_sheet_id_here
WORKSHEET_FORM_SERVICE=Service History (2024-Jun 2025)

# Service Unit Grab
SHEET_ID_SERVICE_GRAB=your_sheet_id_here
WORKSHEET_SERVICE_GRAB=Form responses 1

# Form Responses
SHEET_ID_FORM_RESPONSES=your_sheet_id_here
WORKSHEET_FORM_RESPONSES=Form Responses 1

# List Request SPK
SHEET_ID_REQUEST_SPK=your_sheet_id_here
WORKSHEET_REQUEST_SPK=DATA 2025

# After Repair List
SHEET_ID_AFTER_REPAIR=your_sheet_id_here
WORKSHEET_AFTER_REPAIR=List After Repair

# --- S6-S8: Cabang Sources ---
# Cabang Kembangan
SHEET_ID_CABANG_KEMBANGAN=your_sheet_id_here
WORKSHEET_CABANG_KEMBANGAN=Repair Kmb

# Cabang Depok (Tracker Sparepart WH Depok)
SHEET_ID_CABANG_DEPOK=your_sheet_id_here
WORKSHEET_CABANG_DEPOK=Repair DP

# Cabang Bekasi
SHEET_ID_CABANG_BEKASI=your_sheet_id_here
WORKSHEET_CABANG_BEKASI=Repair BK

# --- Reference Data ---
# Master Asset List
SHEET_ID_ASSET_LIST=your_sheet_id_here
WORKSHEET_ASSET=ALL BIKE NEW

# Data Karyawan (Mekanik List)
SHEET_ID_MEKANIK=your_sheet_id_here
WORKSHEET_MEKANIK=mekanik list

# Data Top Keluhan
SHEET_KAMUS_KELUHAN=your_sheet_id_here
WORKSHEET_TOP_KELUHAN=top_keluhan

# --- Output Configuration ---
# Where to write final ETL results (live data)
SHEET_ID_OUTPUT=your_sheet_id_here
WORKSHEET_OUTPUT=work_orders
WORKSHEET_BAD_OUTPUT=bad_data

# ========================================
# Credentials (REQUIRED)
# ========================================
# Path to your service account JSON file
# Example for local development: ./credentials/your-service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=./credentials/seri-automation-etl.json

# ========================================
# Pipeline Configuration (Optional)
# ========================================
# Set to 'true' to save CSV files locally in output/ folder
SAVE_LOCAL_CSV=true

# Complaint Cleaning Mode
# - false (default): Fallback to original text if no match found (lenient mode)
# - true: Keep empty if no match found (strict mode, cleaner output)
STRICT_COMPLAINT_CLEANING=false

# ========================================
# IMPORTANT NOTES:
# ========================================
# 1. Replace all 'your_sheet_id_here' with actual Google Sheets IDs
# 2. Make sure your service account JSON file is in the credentials/ folder
# 3. Share all Google Sheets with your service account email
# 4. The service account email can be found in your JSON credentials file
#    (look for "client_email" field)
