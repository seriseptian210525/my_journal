# ========================================
# Google Sheets Configuration
# ========================================
# Each Google Sheets file has its own unique Spreadsheet ID
# Format: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit

# --- S1-S5: Form-based Sources ---
# Form Service 2024-25
SHEET_ID_FORM_SERVICE=your_spreadsheet_id_here
WORKSHEET_FORM_SERVICE=Sheet1

# Service Unit Grab
SHEET_ID_SERVICE_GRAB=your_spreadsheet_id_here
WORKSHEET_SERVICE_GRAB=Sheet1

# Form Responses
SHEET_ID_FORM_RESPONSES=your_spreadsheet_id_here
WORKSHEET_FORM_RESPONSES=Form Responses 1

# List Request SPK
SHEET_ID_REQUEST_SPK=your_spreadsheet_id_here
WORKSHEET_REQUEST_SPK=Sheet1

# After Repair List
SHEET_ID_AFTER_REPAIR=your_spreadsheet_id_here
WORKSHEET_AFTER_REPAIR=Sheet1

# --- S6-S8: Cabang Sources ---
# Cabang Kembangan
SHEET_ID_CABANG_KEMBANGAN=your_spreadsheet_id_here
WORKSHEET_CABANG_KEMBANGAN=Sheet1

# Cabang Depok (Tracker Sparepart WH Depok)
SHEET_ID_CABANG_DEPOK=your_spreadsheet_id_here
WORKSHEET_CABANG_DEPOK=Daily Repair 1

# Cabang Bekasi
SHEET_ID_CABANG_BEKASI=your_spreadsheet_id_here
WORKSHEET_CABANG_BEKASI=Sheet1

# --- Reference Data ---
# Master Asset List
SHEET_ID_ASSET_LIST=your_spreadsheet_id_here
WORKSHEET_ASSET=ALL BIKE NEW

# Data Karyawan (Mekanik List)
SHEET_ID_MEKANIK=your_spreadsheet_id_here
WORKSHEET_MEKANIK=mekanik list

# --- Output Configuration ---
# Where to write final ETL results (live data)
SHEET_ID_OUTPUT=your_output_spreadsheet_id_here
WORKSHEET_OUTPUT=ETL_Results

# --- Credentials (REQUIRED) ---
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./credentials/seri-automation-etl.json
